{
  "name": "hamad-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node api.js && tsx watch --clear-screen=false src/index.ts",
    "dev:once": "node api.js && tsx src/index.ts",
    "build": "node api.js && tsc -p tsconfig.build.json",
    "start": "node api.js && node dist/index.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "tsx --test --test-concurrency=1 tests/**/*.test.ts"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@fastify/jwt": "^10.2.1",
    "@fastify/mongodb": "^9.0.2",
    "@fastify/multipart": "^9.2.1",
    "cloudinary": "^2.7.0",
    "dotenv": "^16.6.1",
    "fastify": "5.10.0",
    "node-fetch": "^3.3.2",
    "nodemailer": "^9.0.3"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/nodemailer": "^8.0.1",
    "pino-pretty": "^13.1.3",
    "tsx": "^4.20.3",
    "typescript": "^5.9.2"
  }
}
