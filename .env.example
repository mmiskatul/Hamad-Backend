# =============================================================================
# APPLICATION SERVER
# Controls where the Fastify API runs and how much it logs.
# =============================================================================
HOST=0.0.0.0
PORT=4000
LOG_LEVEL=info

# =============================================================================
# MONGODB DATABASE
# MONGODB_URL is the server connection; MONGODB_DATABASE is the database name.
# MONGODB_DNS_SERVERS is optional; leave blank to use the system DNS resolver.
# =============================================================================
MONGODB_URL=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?appName=<app-name>
MONGODB_DATABASE=one_ai_hub
MONGODB_DNS_SERVERS=

# =============================================================================
# EMAIL VERIFICATION
# Registration and password-reset email codes are valid for this many minutes.
# =============================================================================
EMAIL_VERIFICATION_CODE_EXPIRES_MINUTES=10

# =============================================================================
# ACCESS, REFRESH, AND SESSION TOKENS
# JWT_SECRET signs access JWTs and HMAC-hashes refresh/session tokens.
# ACCESS_TOKEN_EXPIRES_IN controls the short-lived access JWT.
# Refresh tokens rotate on every refresh and expire with the session.
# SESSION_EXPIRES_DAYS is the absolute server-enforced session lifetime.
# Never expose or commit any real secret or issued token.
# =============================================================================
JWT_SECRET=replace-with-a-long-random-secret
ACCESS_TOKEN_EXPIRES_IN=15m
SESSION_EXPIRES_DAYS=30

# =============================================================================
# SMTP EMAIL DELIVERY
# Port 587 normally uses STARTTLS with SMTP_SECURE=false.
# Port 465 normally uses implicit TLS with SMTP_SECURE=true.
# Fill in the host, account, password, and sender email from your SMTP provider.
# =============================================================================
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME="One AI Hub"
