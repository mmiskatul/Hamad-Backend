# =============================================================================
# APPLICATION SERVER
# Controls where the Fastify API runs and how much it logs.
# =============================================================================
HOST=0.0.0.0
PORT=4000
LOG_LEVEL=info

# =============================================================================
# MONGODB DATABASE
# MONGODB_URL is the server connection; MONGODB_DATABASE is the database name.
# MONGODB_DNS_SERVERS is optional; leave blank to use the system DNS resolver.
# =============================================================================
MONGODB_URL=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?appName=<app-name>
MONGODB_DATABASE=one_ai_hub
MONGODB_DNS_SERVERS=

# =============================================================================
# EMAIL VERIFICATION
# Registration and password-reset email codes are valid for this many minutes.
# =============================================================================
EMAIL_VERIFICATION_CODE_EXPIRES_MINUTES=10

# =============================================================================
# ACCESS, REFRESH, AND SESSION TOKENS
# JWT_SECRET signs access JWTs and HMAC-hashes refresh/session tokens.
# ACCESS_TOKEN_EXPIRES_IN controls the short-lived access JWT.
# Refresh tokens rotate on every refresh and expire with the session.
# SESSION_EXPIRES_DAYS is the absolute server-enforced session lifetime.
# Never expose or commit any real secret or issued token.
# =============================================================================
JWT_SECRET=replace-with-a-long-random-secret
ACCESS_TOKEN_EXPIRES_IN=15m
SESSION_EXPIRES_DAYS=30

# =============================================================================
# SMTP EMAIL DELIVERY
# Port 587 normally uses STARTTLS with SMTP_SECURE=false.
# Port 465 normally uses implicit TLS with SMTP_SECURE=true.
# Fill in the host, account, password, and sender email from your SMTP provider.
# =============================================================================
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME="One AI Hub"

# =============================================================================
# AI CHAT CONTEXT
# The backend owns conversation history and sends only this many recent messages
# to the selected provider. Provider requests fail after the configured timeout.
# =============================================================================
AI_MAX_CONTEXT_MESSAGES=30
AI_REQUEST_TIMEOUT_MS=60000

# =============================================================================
# OPENAI / CHATGPT (FREE TIER MODEL IN THE APP)
# Create a key in the OpenAI platform, then set OPENAI_ENABLED=true.
# =============================================================================
OPENAI_ENABLED=false
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-5.6

# =============================================================================
# DEEPSEEK (FREE TIER MODEL IN THE APP)
# Create a key in the DeepSeek platform, then set DEEPSEEK_ENABLED=true.
# =============================================================================
DEEPSEEK_ENABLED=false
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash

# =============================================================================
# GOOGLE GEMINI (PRO TIER MODEL IN THE APP)
# =============================================================================
GEMINI_ENABLED=false
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_MODEL=gemini-3.6-flash

# =============================================================================
# PERPLEXITY (PRO TIER MODEL IN THE APP)
# =============================================================================
PERPLEXITY_ENABLED=false
PERPLEXITY_API_KEY=
PERPLEXITY_BASE_URL=https://api.perplexity.ai
PERPLEXITY_MODEL=sonar

# =============================================================================
# ANTHROPIC / CLAUDE (BUSINESS TIER MODEL IN THE APP)
# =============================================================================
ANTHROPIC_ENABLED=false
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com/v1
ANTHROPIC_MODEL=claude-sonnet-5

# =============================================================================
# XAI / GROK (BUSINESS TIER MODEL IN THE APP)
# =============================================================================
XAI_ENABLED=false
XAI_API_KEY=
XAI_BASE_URL=https://api.x.ai/v1
XAI_MODEL=grok-4.5
